<Project Sdk="Microsoft.NET.Sdk">

  <!-- A content-only package with the `dotnet new dynamic-endpoints` project template. Nothing in content/ is compiled. -->
  <PropertyGroup>
    <PackageId>DynamicEndpoints.Templates</PackageId>
    <PackageType>Template</PackageType>
    <Title>DynamicEndpoints project templates</Title>
    <Description>dotnet new template for an ASP.NET Core minimal API with DynamicEndpoints: EF Core SQLite persistence, admin API, OpenAPI and Swagger UI, a sample processor and seeded demo endpoints.</Description>
    <PackageTags>$(PackageTags);dotnet-new;templates</PackageTags>

    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- Keep .gitignore and .template.config/ – NuGet drops dotfiles by default. -->
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <!-- No globbing at all: the template's .cs, .csproj and .json files are package content, not part of this project. -->
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="content/**/*" Exclude="content/**/bin/**;content/**/obj/**;content/**/*.db;content/**/*.db-*"
             Pack="true" PackagePath="content" />
  </ItemGroup>

</Project>
