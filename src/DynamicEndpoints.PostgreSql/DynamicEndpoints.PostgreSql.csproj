<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>DynamicEndpoints.PostgreSql</PackageId>
    <Description>Instant propagation of DynamicEndpoints changes across instances through PostgreSQL LISTEN/NOTIFY.</Description>
    <PackageTags>$(PackageTags);postgresql;npgsql;listen-notify</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DynamicEndpoints\DynamicEndpoints.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

</Project>
