<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>DynamicEndpoints</PackageId>
    <Description>Runtime-defined, persistent HTTP endpoints for ASP.NET Core: declarative parameter binding, JSON Schema constraints, JsonLogic business rules, custom validators and OpenAPI 3.1 generation. No third-party dependencies.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DynamicEndpoints.Tests" />
    <InternalsVisibleTo Include="DynamicEndpoints.FluentValidation" />
    <InternalsVisibleTo Include="DynamicEndpoints.AdminUI" />
    <InternalsVisibleTo Include="DynamicEndpoints.EntityFrameworkCore" />
  </ItemGroup>

  <!-- The analyzers ship inside this package (analyzers/dotnet/cs), without adding a dependency or a reference. -->
  <ItemGroup>
    <ProjectReference Include="..\DynamicEndpoints.Analyzers\DynamicEndpoints.Analyzers.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_PackAnalyzers</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="_PackAnalyzers">
    <MSBuild Projects="..\DynamicEndpoints.Analyzers\DynamicEndpoints.Analyzers.csproj" Targets="GetTargetPath" RemoveProperties="TargetFramework;RuntimeIdentifier">
      <Output TaskParameter="TargetOutputs" ItemName="_AnalyzerAssembly" />
    </MSBuild>
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_AnalyzerAssembly)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

</Project>
