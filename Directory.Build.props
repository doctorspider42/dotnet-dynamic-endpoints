<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <!-- major.minor is released from here; the patch number is set by the release workflow on every push to main -->
    <VersionPrefix>0.3.0</VersionPrefix>
    <Authors>Pawel Pajak</Authors>
    <Copyright>Copyright (c) 2026 Pawel Pajak</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/doctorspider42/dotnet-dynamic-endpoints</PackageProjectUrl>
    <RepositoryUrl>https://github.com/doctorspider42/dotnet-dynamic-endpoints</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>https://github.com/doctorspider42/dotnet-dynamic-endpoints/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageTags>aspnetcore;minimal-api;dynamic;endpoints;runtime;routing;json-schema;jsonlogic;openapi;low-code</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Each package ships the README.md next to its project file (shown on nuget.org). -->
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md')">
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md')">
    <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
