    `extern alias QuickStart;` … `new SampleApp<QuickStart::Program>()`.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\samples\01-QuickStart\DynamicEndpoints.Samples.QuickStart.csproj" Aliases="QuickStart" />
    <ProjectReference Include="..\..\samples\02-Validation\DynamicEndpoints.Samples.Validation.csproj" Aliases="Validation" />
    <ProjectReference Include="..\..\samples\03-CustomProcessors\DynamicEndpoints.Samples.CustomProcessors.csproj" Aliases="CustomProcessors" />
    <ProjectReference Include="..\..\samples\04-BuiltInProcessors\DynamicEndpoints.Samples.BuiltInProcessors.csproj" Aliases="BuiltInProcessors" />
    <ProjectReference Include="..\..\samples\05-EfCrud\DynamicEndpoints.Samples.EfCrud.csproj" Aliases="EfCrud" />
    <ProjectReference Include="..\..\samples\06-MultiTenancy\DynamicEndpoints.Samples.MultiTenancy.csproj" Aliases="MultiTenancy" />
    <ProjectReference Include="..\..\samples\07-OpenApiImport\DynamicEndpoints.Samples.OpenApiImport.csproj" Aliases="OpenApiImport" />
    <ProjectReference Include="..\..\samples\08-GitOps\DynamicEndpoints.Samples.GitOps.csproj" Aliases="GitOps" />
    <ProjectReference Include="..\..\samples\09-DraftsHistoryAudit\DynamicEndpoints.Samples.DraftsHistoryAudit.csproj" Aliases="DraftsHistoryAudit" />
    <ProjectReference Include="..\..\samples\10-CachingAndRateLimits\DynamicEndpoints.Samples.CachingAndRateLimits.csproj" Aliases="CachingAndRateLimits" />
    <ProjectReference Include="..\..\samples\11-Observability\DynamicEndpoints.Samples.Observability.csproj" Aliases="Observability" />
  </ItemGroup>

</Project>
