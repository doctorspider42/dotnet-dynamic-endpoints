    <ProjectReference Include="..\..\src\DynamicEndpoints.EntityFrameworkCore\DynamicEndpoints.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\src\DynamicEndpoints.AdminUI\DynamicEndpoints.AdminUI.csproj" />
    <!-- Package consumers get the analyzers automatically; project references need them wired up explicitly. -->
    <ProjectReference Include="..\..\src\DynamicEndpoints.Analyzers\DynamicEndpoints.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
